    "更新情報の確認時も、ファイルや画像は送信しません。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking for updates never sends your files or images." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "更新情報の確認時も、ファイルや画像は送信しません。" } } } },
