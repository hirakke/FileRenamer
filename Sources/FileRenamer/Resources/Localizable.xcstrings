    "読み込みをキャンセルしました" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Cancelled" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込みをキャンセルしました" } } } },
