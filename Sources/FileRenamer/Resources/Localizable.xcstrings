    "読み込む" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込む" } } } },
    "読み込めませんでした" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t Import" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込めませんでした" } } } },
    "追加できるファイルがありません" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Files to Add" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "追加できるファイルがありません" } } } },
    "選択したファイルをゴミ箱に移動します" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Selected Files to Trash" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルをゴミ箱に移動します" } } } },
    "選択した場所に元画像専用の新しいフォルダを作成します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A new folder for original images will be created in the selected location." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択した場所に元画像専用の新しいフォルダを作成します。" } } } },
    "類似" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Similar" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "類似" } } } },
    "広告、分析、ユーザー追跡を行わず、データを第三者へ提供しません。更新確認を有効にした場合は、最新バージョンの有無を確認するため更新情報サーバーへ接続しますが、ファイル、画像、利用状況は送信しません。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "FileRenamer does not use advertising, analytics, or user tracking, and does not share data with third parties. If update checking is enabled, it connects to the update server only to check whether a newer version is available; it never sends files, images, or usage data." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "広告、分析、ユーザー追跡を行わず、データを第三者へ提供しません。更新確認を有効にした場合は、最新バージョンの有無を確認するため更新情報サーバーへ接続しますが、ファイル、画像、利用状況は送信しません。" } } } },
    "設定、命名ルール、Undo履歴、復旧情報、必要な画像バックアップをこのMac内に保存します。古いUndo履歴と関連バックアップは、アプリの保存上限に従って削除されます。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings, naming rules, Undo history, recovery information, and any needed image backups are stored on this Mac. Older Undo history and related backups are removed according to the app’s storage limit." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定、命名ルール、Undo履歴、復旧情報、必要な画像バックアップをこのMac内に保存します。古いUndo履歴と関連バックアップは、アプリの保存上限に従って削除されます。" } } } },
    "選択したファイルへのアクセスは、読み込み、プレビュー、名前変更、画像変換、リサイズ、類似画像候補のローカル比較、ユーザーが明示的に選んだファイルのゴミ箱への移動、Undo、失敗時の復旧にだけ使用します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Access to selected files is used only for importing, previewing, renaming, image conversion, resizing, local comparison of similar-image candidates, moving files you explicitly select to Trash, Undo, and recovery after failure." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルへのアクセスは、読み込み、プレビュー、名前変更、画像変換、リサイズ、類似画像候補のローカル比較、ユーザーが明示的に選んだファイルのゴミ箱への移動、Undo、失敗時の復旧にだけ使用します。" } } } },
    "preset.recovered.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Presets Recovered" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プリセットを復旧しました" } } } },
    "undo.unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "There is no rename history to undo." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "元に戻せるリネーム履歴がありません。" } } } },
    "undo.confirmation.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The last change to %d file(s) will be undone." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "直前に変更した%dファイルを、元の状態に戻します。" } } } },
    "imageChange.resaved" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ • Re-saved as %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ • %@へ再保存" } } } },
    "busy.loading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み込み中…" } } } },
