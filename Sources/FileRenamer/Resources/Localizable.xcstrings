    "ウィンドウを開いたときにサイドバーを表示" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show sidebar when opening a window" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウィンドウを開いたときにサイドバーを表示" } } } },
