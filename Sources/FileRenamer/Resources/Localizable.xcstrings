    "settings.preventUpscalingByDefaultWhen" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prevent upscaling by default when resizing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リサイズでは拡大を防ぐ設定を初期値にする" } } } },
    "settings.appliedWhenYouFirstEnable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Applied when you first enable resizing in Image Settings." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像設定でリサイズを新しく有効にしたときに適用します。" } } } },
    "settings.doNotRecompressJpegFiles" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Do not recompress JPEG files at 100% when format and size are unchanged" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "JPEG 100%・同形式・リサイズなしでは再圧縮しない" } } } },
    "settings.whenOnMatchingJpegData" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, matching JPEG data remains unchanged and only the file name is changed." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オンの場合、対象のJPEGデータは変更せず、必要な名前変更だけを行います。" } } } },
    "settings.similarImages" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Similar Images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "類似画像" } } } },
    "settings.checkForSimilarImages" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for similar images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "類似している可能性のある画像を確認" } } } },
    "settings.findExactDuplicateFilesOnly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Find exact duplicate files only" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "完全に同一のファイルだけ検出" } } } },
