    "settings.dataHandling" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Data Handling" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "データの処理" } } } },
    "settings.onThisMacOnly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On This Mac Only" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMac内のみ" } } } },
    "settings.showPrivacyPolicy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Privacy Policy…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーポリシーを表示…" } } } },
    "settings.privacyPolicy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy Policy" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プライバシーポリシー" } } } },
    "settings.filerenamerProcessesTheFilesYou" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "FileRenamer processes the files you select only on this Mac. It does not send or collect your files, names, images, metadata, or usage data." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "FileRenamerは、ユーザーが選択したファイルをこのMac内で処理します。ファイル、ファイル名、画像、メタデータ、利用状況を開発者へ送信または収集しません。" } } } },
    "settings.fileAccess" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File Access" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ファイルへのアクセス" } } } },
    "settings.accessToSelectedFilesIs" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Access to selected files is used only for importing, previewing, renaming, image conversion, resizing, local comparison of similar-image candidates, moving files you explicitly select to Trash, Undo, and recovery after failure." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したファイルへのアクセスは、読み込み、プレビュー、名前変更、画像変換、リサイズ、類似画像候補のローカル比較、ユーザーが明示的に選んだファイルのゴミ箱への移動、Undo、失敗時の復旧にだけ使用します。" } } } },
    "settings.informationStoredOnThisMac" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Information Stored on This Mac" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacに保存する情報" } } } },
    "settings.settingsNamingRulesUndoHistory" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings, naming rules, Undo history, recovery information, and any needed image backups are stored on this Mac. Older Undo history and related backups are removed according to the app’s storage limit." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定、命名ルール、Undo履歴、復旧情報、必要な画像バックアップをこのMac内に保存します。古いUndo履歴と関連バックアップは、アプリの保存上限に従って削除されます。" } } } },
    "settings.trackingAndSharing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tracking and Sharing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "追跡と第三者提供" } } } },
    "settings.filerenamerDoesNotUseAdvertising" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "FileRenamer does not use advertising, analytics, or user tracking, and does not share data with third parties. If update checking is enabled, it connects to the update server only to check whether a newer version is available; it never sends files, images, or usage data." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "広告、分析、ユーザー追跡を行わず、データを第三者へ提供しません。更新確認を有効にした場合は、最新バージョンの有無を確認するため更新情報サーバーへ接続しますが、ファイル、画像、利用状況は送信しません。" } } } },
    "settings.effectiveDateAugust132026" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Effective date: August 13, 2026" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "制定日：2026年8月13日" } } } },
    "settings.close" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "閉じる" } } } },
    "preview.couldnTLoadImage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t Load Image" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像を読み込めませんでした" } } } },
    "preview.checkTheAccessPermissionOr" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check the access permission or supported format." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセス権または対応形式を確認してください。" } } } },
