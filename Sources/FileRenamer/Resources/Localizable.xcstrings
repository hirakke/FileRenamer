    "実行前に変更内容を確認" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review changes before renaming" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実行前に変更内容を確認" } } } },
    "変更前後のファイル名、画像処理、原本の扱いを一覧で確認します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Review file names, image processing, and original-file handling before continuing." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "変更前後のファイル名、画像処理、原本の扱いを一覧で確認します。" } } } },
    "画像を変換・リサイズする前に原本の扱いを確認" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm original-file handling before converting or resizing images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像を変換・リサイズする前に原本の扱いを確認" } } } },
    "オフの場合は元画像を置き換えます。ファイル名の衝突防止と失敗時の復元は常に有効です。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When off, the original image is replaced. Name-conflict protection and recovery after failure remain active." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフの場合は元画像を置き換えます。ファイル名の衝突防止と失敗時の復元は常に有効です。" } } } },
    "Undoの前に確認" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm before undoing a rename" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Undoの前に確認" } } } },
    "画像処理" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image Processing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像処理" } } } },
    "リサイズでは拡大を防ぐ設定を初期値にする" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prevent upscaling by default when resizing" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リサイズでは拡大を防ぐ設定を初期値にする" } } } },
    "画像設定でリサイズを新しく有効にしたときに適用します。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Applied when you first enable resizing in Image Settings." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像設定でリサイズを新しく有効にしたときに適用します。" } } } },
    "JPEG 100%・同形式・リサイズなしでは再圧縮しない" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Do not recompress JPEG files at 100% when format and size are unchanged" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "JPEG 100%・同形式・リサイズなしでは再圧縮しない" } } } },
    "オンの場合、対象のJPEGデータは変更せず、必要な名前変更だけを行います。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, matching JPEG data remains unchanged and only the file name is changed." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オンの場合、対象のJPEGデータは変更せず、必要な名前変更だけを行います。" } } } },
    "類似画像" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Similar Images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "類似画像" } } } },
    "類似している可能性のある画像を確認" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for potentially similar images" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "類似している可能性のある画像を確認" } } } },
    "完全に同一のファイルだけ検出" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Find exact duplicate files only" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "完全に同一のファイルだけ検出" } } } },
    "検出感度" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detection Sensitivity" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "検出感度" } } } },
    "RAW＋JPEGの組み合わせを候補から除外" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Exclude RAW + JPEG pairs from suggestions" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "RAW＋JPEGの組み合わせを候補から除外" } } } },
    "画像特徴の比較はこのMac内で行います。候補を表示するだけで、自動的な削除や除外は行いません。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image-feature comparisons stay on this Mac. FileRenamer only shows suggestions; it never removes or excludes files automatically." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像特徴の比較はこのMac内で行います。候補を表示するだけで、自動的な削除や除外は行いません。" } } } },
    "表示" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Display" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "表示" } } } },
