    "main.undoTheRename" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Undo the rename?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リネームを元に戻しますか？" } } } },
